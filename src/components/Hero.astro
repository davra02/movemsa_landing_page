---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" id="inicio">
  <div class="hero__content container">
    <div class="hero__panel">
      <span class="section-label hero__label">{t('heroLabel')}</span>

      <h1 class="hero__title">
        {t('heroTitle1')}<br />
        <em>{t('heroTitle2')}</em>
      </h1>

      <p class="hero__sub">{t('heroSub')}</p>

      <div class="hero__actions">
        <a href="#actividades" class="btn-primary">{t('heroCta1')}</a>
        <a href="#por-que" class="btn-outline">{t('heroCta2')}</a>
      </div>
    </div>
  </div>

  <!-- Wave divider -->
  <div class="hero__wave" aria-hidden="true">
    <svg viewBox="0 0 1440 90" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0,40 C360,90 1080,0 1440,50 L1440,90 L0,90 Z" fill="#F5FAFA"/>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    background: var(--clr-surface-dark);
    background-image: url('../assets/banner.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    pointer-events: none;
    z-index: 0;
  }

  .hero__ghost {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    pointer-events: none;
    z-index: 1;
  }

  .hero__ghost img {
    width: min(70vw, 600px);
    height: auto;
    filter: invert(1) brightness(1.5);
    mix-blend-mode: screen;
    opacity: 0.12;
    transform: translateX(10%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 90%;
    padding: 0;
  }

  .hero__panel {
    width: fit-content;
    margin-inline: auto;
    text-align: center;
    padding-block: 9rem 7rem;
    padding-inline: 2rem;
    background: rgba(22, 51, 48, 0.6);
    border-radius: var(--radius);
    backdrop-filter: blur(4px);
  }

  .hero__label {
    display: block;
    margin-block-end: 1.5rem;
    color: var(--clr-primary);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 8vw, 5.5rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--clr-white);
    margin-block-end: 1.5rem;
  }

  .hero__title em {
    font-style: italic;
    color: var(--clr-primary);
  }

  .hero__sub {
    font-size: 1.3rem;
    color: rgba(255,255,255,0.7);
    max-width: 700px;
    margin-inline: auto;
    text-wrap: balance;
    line-height: 1.75;
    margin-block-end: 2.5rem;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero__wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    line-height: 0;
  }

  .hero__wave svg {
    width: 100%;
    height: 90px;
  }
</style>
